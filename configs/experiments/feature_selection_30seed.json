{
  "name": "feature_selection_30seed",
  "status": "exploratory",
  "entrypoint": "scripts/tools/feature_selection_pipeline.py",
  "supports_log_dir": true,
  "arguments": {
    "seeds": 30,
    "methods": "all,spearman,mutual_info,tree_importance",
    "seq-groups": "mut,wd,struct",
    "force-keep-groups": "mut",
    "top-k": 100,
    "target": "winsor",
    "loss": "mae",
    "eval-models": "ET,GBR,XGB",
    "stability-inner-folds": 5,
    "stability-threshold": 0.6,
    "n-jobs": 4,
    "data-dir": "data/proxy2000_v2"
  },
  "acceptance": {
    "minimum_seeds": 30,
    "selection_must_be_nested": true,
    "promotion_requires_paired_improvement": true,
    "promotion_mean_delta_min": 0.005,
    "promotion_bootstrap_ci95_low_gt": 0.0,
    "promotion_win_rate_min": 0.6
  }
}
